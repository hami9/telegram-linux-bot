{
    "name": "mygateway/my-gateway-for-woocommerce",
    "description": "درگاه پرداخت حرفه‌ای، امن و ماژولار برای ووکامرس با معماری شیءگرا و استاندارد PSR-4",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "woocommerce",
        "payment-gateway",
        "iran",
        "persian"
    ],
    "authors": [
        {
            "name": "MyGateway Team"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-curl": "*",
        "monolog/monolog": "^2.9",
        "sallar/jdatetime": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "MyGateway\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": false
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"echo 'MyGateway dependencies installed successfully.' . PHP_EOL;\""
        ]
    }
}
